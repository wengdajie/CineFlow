# ============================================================
# CineFlow 环境变量示例（复制为 .env）
# 所有配置项统一使用 CF_ 前缀，优先级高于 config/config.yaml
# 列表型配置用英文逗号分隔
# ============================================================

# ---------- 基础 ----------
CF_HOST=0.0.0.0
CF_PORT=8611
CF_TIMEZONE=Asia/Shanghai
CF_LOG_LEVEL=INFO
CF_DEBUG=false

# ---------- 目录 ----------
CF_DATA_DIR=/app/data
CF_DOWNLOAD_DIR=/downloads
CF_LIBRARY_DIR=/library
CF_STRM_DIR=/strm
CF_PLUGIN_DIR=/app/plugins

# ---------- 安全（务必修改）----------
CF_SECRET_KEY=please-change-this-to-a-random-string
CF_SUPERUSER=admin
CF_SUPERUSER_PASSWORD=cineflow
CF_TOKEN_EXPIRE_MINUTES=10080
CF_API_TOKEN=

# ---------- 整理 ----------
CF_TRANSFER_MODE=link
CF_MIN_FILE_SIZE_MB=100

# ---------- 调度 ----------
CF_SCHEDULER_ENABLED=true
CF_SUBSCRIBE_INTERVAL_MINUTES=30
# 追新雷达：以站点最新流驱动的低延迟追新
CF_RADAR_ENABLED=true
CF_RADAR_INTERVAL_MINUTES=15
CF_RADAR_LIMIT_PER_SITE=100
CF_DOWNLOAD_CHECK_INTERVAL_MINUTES=5
CF_LIBRARY_SCAN_CRON=0 4 * * *

# ---------- 择优策略 ----------
CF_AUTO_DOWNLOAD_BEST=true
CF_PREFER_RESOLUTIONS=2160p,1080p,720p
CF_EXCLUDE_KEYWORDS=枪版,抢先版,CAM,预告片,Sample
CF_MIN_SEEDERS=0

# ---------- TMDB（可留空）----------
CF_TMDB_API_KEY=
CF_TMDB_LANGUAGE=zh-CN

# ---------- 网络 ----------
CF_HTTP_PROXY=

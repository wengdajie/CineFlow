# ============================================================
# CineFlow 环境变量示例（复制为 .env）
# 所有配置项统一使用 CF_ 前缀，优先级高于 config/config.yaml
# 列表型配置用英文逗号分隔
# ============================================================

# ---------- 基础 ----------
CF_HOST=0.0.0.0
CF_PORT=6060
CF_TIMEZONE=Asia/Shanghai
CF_LOG_LEVEL=INFO
CF_DEBUG=false

# ---------- 目录 ----------
CF_DATA_DIR=/app/data
CF_DOWNLOAD_DIR=/downloads
CF_LIBRARY_DIR=/library
CF_STRM_DIR=/strm
CF_PLUGIN_DIR=/app/plugins

# ---------- 安全（务必修改）----------
CF_SECRET_KEY=please-change-this-to-a-random-string
CF_SUPERUSER=admin
CF_SUPERUSER_PASSWORD=cineflow
CF_TOKEN_EXPIRE_MINUTES=10080
CF_API_TOKEN=

# ---------- 整理 ----------
CF_TRANSFER_MODE=link
CF_MIN_FILE_SIZE_MB=100

# ---------- 调度 ----------
CF_SCHEDULER_ENABLED=true
CF_SUBSCRIBE_INTERVAL_MINUTES=30
# 追新雷达：以站点最新流驱动的低延迟追新
CF_RADAR_ENABLED=true
CF_RADAR_INTERVAL_MINUTES=15
CF_RADAR_LIMIT_PER_SITE=100
CF_DOWNLOAD_CHECK_INTERVAL_MINUTES=5
CF_LIBRARY_SCAN_CRON=0 4 * * *

# ---------- 择优策略 ----------
CF_AUTO_DOWNLOAD_BEST=true
CF_PREFER_RESOLUTIONS=2160p,1080p,720p
CF_EXCLUDE_KEYWORDS=枪版,抢先版,CAM,预告片,Sample
CF_MIN_SEEDERS=0

# ---------- TMDB（可留空）----------
CF_TMDB_API_KEY=
CF_TMDB_LANGUAGE=zh-CN

# ---------- 刮削（NFO + 图片）----------
# 入库后自动写 NFO，让 Emby/Jellyfin 不用自己猜（国产剧/冷门片识别率提升明显）
CF_SCRAPE_ENABLED=true
CF_SCRAPE_IMAGES=true
# 默认不覆盖已有 NFO：用户手工修过的不能被定时任务冲掉
CF_SCRAPE_OVERWRITE=false
CF_SCRAPE_CRON=30 4 * * *
CF_SCRAPE_BATCH=200

# ---------- 分类归档 ----------
# 开启后在媒体库下再分「电影/电视剧/动漫/纪录片/综艺/儿童」二级目录
# 判定不出来的**不归档**（宁可不分类也不要归错）；老库开启前请先想清楚
CF_CATEGORY_ENABLED=false

# ---------- STRM（网盘直连播放）----------
CF_STRM_ENABLED=false
# 写进 .strm 的链接形式：
#   proxy  = 写 CineFlow 的 302 端点，链接永不过期（推荐）
#   direct = 写网盘临时直链，NAS 零流量但会过期
CF_STRM_LINK_MODE=proxy
# proxy 模式下播放器要访问的地址，必须是媒体服务器能连通的地址
CF_STRM_BASE_URL=http://127.0.0.1:6060
# 定时同步周期（分钟），0 = 关闭自动同步
CF_STRM_SYNC_INTERVAL_MINUTES=0
# 网盘上源文件消失时删掉对应 .strm，避免媒体库出现点不开的空剧集
CF_STRM_CLEAN_INVALID=true
# 同步字幕/NFO/图片等随行文件
CF_STRM_SYNC_METADATA=true

# ---------- 网盘分享追更 ----------
CF_PAN_SUBSCRIBE_INTERVAL_MINUTES=60
# 连续失败多少次后标记分享失效并停手，避免对死链无限重试
CF_PAN_SUBSCRIBE_MAX_FAILURES=5

# ---------- 洗版（更优版本替换）----------
# 默认关闭：它会删除已入库文件，请确认理解后再开
CF_UPGRADE_ENABLED=false
# 评分至少提升这么多才替换（防止 1080p/2160p 反复横跳）
CF_UPGRADE_SCORE_DELTA=15
# 每个文件最多洗版几次
CF_UPGRADE_MAX_TIMES=2

# ---------- 网络 ----------
CF_HTTP_PROXY=
